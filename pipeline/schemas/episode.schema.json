{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JussCubs/jev-podcast-studio/pipeline/schemas/episode.schema.json",
  "title": "PodcastEpisode",
  "description": "A two-or-more-host episode the studio can validate, score, and render.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "genre", "hosts", "turns"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "show": { "type": "string" },
    "preset": {
      "type": "string",
      "default": "general",
      "description": "Preset id matching presets/<id>.json. Default general = full toolkit."
    },
    "genre": {
      "type": "string",
      "enum": [
        "informative",
        "narrative",
        "interview",
        "educational",
        "comedy",
        "musical",
        "dramatic"
      ]
    },
    "language": { "type": "string", "default": "en" },
    "stage": {
      "type": "string",
      "enum": ["plain", "performed"],
      "description": "plain = no speech tags required; performed = tags expected in turn.text"
    },
    "target_duration_sec": { "type": "number", "minimum": 30, "maximum": 7200 },
    "one_sentence_promise": {
      "type": "string",
      "description": "What a listener can repeat after the episode."
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "voice_id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["host", "cohost", "guest", "narrator"]
          },
          "voice_id": {
            "type": "string",
            "description": "xAI voice id (leo, ara, eve, rex, sal) or a custom voice id."
          },
          "tts_provider": {
            "type": "string",
            "enum": ["xai", "chatterbox", "fish"],
            "default": "xai"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "purpose": { "type": "string" },
          "one_idea": { "type": "string" },
          "target_sec": { "type": "number" }
        }
      }
    },
    "cold_open_candidates": {
      "type": "array",
      "description": "Optional ranked set. Jev Choice picks one before the heavy model writes the rest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "hook_type": {
            "type": "string",
            "enum": ["tension", "number", "confession", "scene", "question", "song"]
          }
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speaker", "text"],
        "properties": {
          "id": { "type": "string" },
          "speaker": {
            "type": "string",
            "description": "Must match hosts[].id"
          },
          "beat_id": { "type": "string" },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Spoken line. Performed stage may include inline [tags] and <wrap></wrap> tags."
          },
          "text_plain": {
            "type": "string",
            "description": "Tag-stripped copy kept for transcripts / Jev state."
          },
          "estimated_sec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "sfx_plan": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "cold-open-hit",
              "key-number-ding",
              "section-whoosh",
              "outro",
              "custom"
            ]
          },
          "at_turn_id": { "type": "string" },
          "offset_ms": { "type": "integer" },
          "file": { "type": "string" },
          "gain_db": { "type": "number" },
          "duck_db": { "type": "number" }
        }
      }
    },
    "pronunciation": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Phrase → spoken form, passed through to xAI TTS `replace`."
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
