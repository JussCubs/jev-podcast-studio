# Copy to .env locally. Never commit secrets.
# Dry-run validation needs no keys.

# xAI Text-to-Speech (primary renderer)
# https://docs.x.ai/developers/model-capabilities/audio/text-to-speech
XAI_API_KEY=

# OpenRouter — Jev Decisions API (judge, not writer)
# https://openrouter.ai/docs/guides/community/jev
OPENROUTER_API_KEY=

# Pin a Jev release, or use the rolling alias.
JEV_MODEL=typesafe/jev-1.13
# JEV_MODEL=~typesafe/jev-latest

# Optional HTTP headers OpenRouter uses for rankings / attribution
OPENROUTER_HTTP_REFERER=https://github.com/JussCubs/jev-podcast-studio
OPENROUTER_TITLE=jev-podcast-studio

# Default preset id (files live in presets/<id>.json). "general" = full toolkit.
PODCAST_PRESET=general

# Optional: override xAI TTS endpoint (tests / proxies)
# XAI_TTS_URL=https://api.x.ai/v1/tts
