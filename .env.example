# Copy to .env and fill in to enable live xAI script generation + expressive TTS.
# When unset, the studio runs fully offline with deterministic fallbacks.

# xAI API key (https://console.x.ai). Enables Grok script generation and TTS.
XAI_API_KEY=

# Base URL for the xAI OpenAI-compatible API.
XAI_BASE_URL=https://api.x.ai/v1

# Heavy model used for script generation.
XAI_SCRIPT_MODEL=grok-2-latest

# xAI text-to-speech model + voice (used only when XAI_API_KEY is set).
XAI_TTS_MODEL=grok-tts
XAI_TTS_VOICE=ember

# HTTP port for the studio web server.
PORT=3000
